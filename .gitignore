# Ignore hidden files except the .gitignore and .gitmodules
.*
!.gitignore
!.gitmodules

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.ex
bin/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Explorer web UI: dependencies, and the build output that web/embed.go
# embeds. The placeholder keeps the package compiling before the UI is built.
node_modules/
web/dist/*
!web/dist/.gitkeep
!web/public/.gitkeep

# The explorer's store: what it found, and the admin's decisions.
data/
